# Copy to .env (which is git-ignored) and fill in. Never commit the real key,
# and never paste it into an issue, a pull request or a notebook.
#
# Only the dashboard's language-model features (summaries, question answering)
# need this. The 6.3 modelling work in ml/ needs no key at all.

LLM_API_KEY=
LLM_MODEL=qwen.qwen3-vl-235b-a22b-instruct
AWS_REGION=us-east-1
# Base URL of the OpenAI-compatible endpoint the key belongs to.
LLM_BASE_URL=
