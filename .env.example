# Copy to .env (which is git-ignored) and fill in. Never commit the real key,
# and never paste it into an issue, a pull request or a notebook.
#
# Only the dashboard's language-model features (summaries, question answering)
# need this. The 6.3 modelling work in ml/ needs no key at all.

LLM_API_KEY=
LLM_MODEL=qwen.qwen3-vl-235b-a22b-instruct
AWS_REGION=us-east-1
# Amazon Bedrock's OpenAI-compatible ("Mantle") endpoint for the region above.
# Any OpenAI-style client works: point its base URL here and pass LLM_API_KEY
# as the API key. Checked 15 Nov 2026: /models lists the model above, and
# /chat/completions answers both plain and tool-calling requests.
LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1

# The voice guide (optional). With both set, the Explain buttons speak through
# an ElevenLabs agent that the listener can interrupt and question. Without
# them the browser reads the explanation aloud and cannot answer questions.
# Create the agent once with: cd backend && python -m app.voice
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
